APP_NAME=TuStack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_NOINDEX=true
APP_AVAILABLE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tustack
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: smtp against MailHog (127.0.0.1:1025). Production: resend
MAIL_MAILER=log
RESEND_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tustack.es"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
# Internal host, used by Scout only
MEILISEARCH_HOST=http://127.0.0.1:7701
# Public host the browser talks to. Empty falls back to MEILISEARCH_HOST
MEILISEARCH_PUBLIC_HOST=
# Search-only key, restricted to the companies index, exposed to the browser
MEILISEARCH_KEY=
# Admin key, used by Scout to write to the index. Never exposed
MEILISEARCH_ADMIN_KEY=

ADZUNA_APP_ID=
ADZUNA_APP_KEY=

JOOBLE_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Production only, must be public HTTPS. Register it with: php artisan telegram:webhook --setup
TELEGRAM_BOT_WEBHOOK_URL="${APP_URL}/telegram/webhook"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

SENTRY_LARAVEL_DSN=

GEMINI_ENABLED=false
GEMINI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

ANALYTICS_ENABLED=false
